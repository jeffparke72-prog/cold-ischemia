    }
   ],
   "t0": 156.274,
   "t1": 161.544
  },
  {
   "s": "close",
   "w": "N",
   "text": "Unbought. Unafraid. Unfinished.",
   "gap": 1.1,
   "big": [
    {
     "t": "UNBOUGHT.",
     "c": "a",
     "pos": "c",
     "y": -130,
