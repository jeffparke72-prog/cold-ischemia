    "src": "/stress.png",
    "dim": 0.68,
    "blur": 12,
    "pan": "right",
    "zoom": 0.06
   },
   "intensity": 0.5,
   "lines": [
    {
     "t": "A PAMPHLET.",
     "c": "ink"
    },
    {
     "t": "NOT AN ANSWER.",
     "c": "alert"
    }
   ],
   "heartbeat": true
  },
  {
   "id": "market",
   "type": "title",
   "text": "They told you this was a disease you manage. They never told you it was a market you are inside.",
