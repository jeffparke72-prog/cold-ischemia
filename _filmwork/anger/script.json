 "segments": [
  {
   "id": "chair",
   "type": "title",
   "text": "I know the chair. I know the cold of it. The four hours that stop being yours.",
   "bg": {
    "src": "/night-shift.png",
    "dim": 0.6,
    "blur": 6,
    "pan": "left",
    "zoom": 0.06
   },
   "intensity": 0.45,
   "lines": [
    {
     "t": "I KNOW THE CHAIR.",
     "c": "ink"
    }
   ],
   "heartbeat": true,
   "hits": [
    0.05
   ]
  },
  {
   "id": "pamphlet",
   "type": "title",
   "text": "I know what it is to be handed a pamphlet when what you needed was an answer. And I know the look on a face when someone finally realizes that nobody is coming to explain.",
