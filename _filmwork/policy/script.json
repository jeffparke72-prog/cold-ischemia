   "intensity": 0.75,
   "hits": [
    0.15
   ]
  },
  {
   "id": "outlasted",
   "type": "list",
   "text": "It has outlasted every press release, every task force, and every promise made in a ballroom and forgotten by the parking lot.",
   "t0": 260.18,
   "dur": 10.36,
   "bg": {
    "src": "/transplant-loopholes.png",
