     "t": "Data that belongs to the person",
     "s": "Not to the institution that profits from it"
    },
    {
     "t": "Measures that judge a system by how fast it listens"
    }
   ],
   "intensity": 0.55
  },
  {
   "id": "care",
   "type": "list",
   "text": "Care partners written into the record as experts. Technology that holds the line when every office is closed and every phone goes unanswered. And an advocacy that does not ask for a seat at the table, but audits the table itself.",
   "t0": 227.45,
   "dur": 24.21,
   "bg": {
    "src": "/accountability-corridor.png",
    "dim": 0.68,
    "blur": 22,
    "zoom": 0.06,
    "pan": "right"
   },
   "rows": [
    {
     "t": "Care partners written into the record as experts"
    },
    {
     "t": "Technology that holds the line",
     "s": "When every office is closed and every phone goes unanswered"
    },
    {
     "t": "An advocacy that audits the table itself",
     "s": "Not one that asks for a seat"
    }
   ],
   "intensity": 0.6
  },
  {
   "id": "polite",
   "type": "title",
   "text": "This is not reform requested politely. The status quo is obdurate.",
   "t0": 252.77,
   "dur": 7.2,
   "bg": {
    "src": "/transplant-loopholes.png",
    "dim": 0.68,
    "blur": 22,
