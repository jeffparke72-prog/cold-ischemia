     "t": "Every promise made in a ballroom",
     "s": "And forgotten by the parking lot"
    }
   ],
   "intensity": 0.75
  },
  {
   "id": "permission",
   "type": "title",
   "text": "We are not asking for permission. We are building what the system declined to build, and we are measuring what it refused to measure.",
   "t0": 271.24,
   "dur": 9.35,
   "bg": {
    "src": "/night-shift.png",
    "dim": 0.58,
